{
  "name": "pedila",
  "productName": "Pedila",
  "version": "0.11.2-beta",
  "private": true,
  "description": "Pedila: una ventana sencilla para usar Hermes Agent (el de tu PC y el de tu servidor) y tus terminales de IA (Claude Code, Hermes, Antigravity) en pestañas. Cliente no oficial.",
  "author": "Pedila",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "assets": "electron scripts/make-icon.js && electron --disable-gpu scripts/make-pet.js && node scripts/vendor.mjs",
    "dist": "npm run assets && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "marked": "18.1.3"
  },
  "build": {
    "appId": "org.pedila.app",
    "productName": "Pedila",
    "files": [
      "src/**",
      "!src/assets/pets/default/**",
      "package.json",
      "!node_modules/node-pty/{src,deps,third_party,scripts,typings,build/Release/obj,binding.gyp}/**",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**",
      "!node_modules/node-pty/**/*.pdb"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pedila-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "repository": "https://github.com/ElKiro1311/pedila"
}
