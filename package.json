{
  "name": "pedila",
  "productName": "Pedila",
  "version": "0.4.2",
  "private": true,
  "description": "Pedila: una ventana sencilla para usar Hermes Agent (el de tu PC y el de tu servidor). Cliente no oficial.",
  "author": "Pedila",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "assets": "electron scripts/make-icon.js && node scripts/vendor.mjs",
    "dist": "npm run assets && electron-builder --win nsis --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "marked": "18.1.3"
  },
  "build": {
    "appId": "org.pedila.app",
    "productName": "Pedila",
    "files": [
      "src/**",
      "!src/assets/pets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pedila-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "repository": "https://github.com/ElKiro1311/pedila"
}
